# Copy to .env (git-ignored, chmod 600) and fill in. Variable names only; never commit values.
CATSDWAN_URL=https://sdwan-manager.example.com
CATSDWAN_USERNAME=
CATSDWAN_PASSWORD=
# CATSDWAN_PASSWORD_FILE=/run/secrets/catsdwan_password   # instead of CATSDWAN_PASSWORD
CATSDWAN_VERIFY_SSL=true
# CATSDWAN_CA_BUNDLE=/path/to/ca.pem
# CATSDWAN_AUTH=auto               # auto (JWT, else session) | jwt (20.18.1+) | session
# CATSDWAN_SESSION_SECONDS=1800    # JWT lifetime asked for at login (300-1800; 20.18.3 refuses more)
# CATSDWAN_TENANT=                 # multi-tenant Manager, provider login: tenant name or id (off by default)
# CATSDWAN_TIMEOUT=30
# CATSDWAN_RETRIES=2
# CATSDWAN_RATE_LIMIT=6000         # requests per minute (default 6000 = the Manager's 100/s per user)
# CATSDWAN_MAX_CONCURRENCY=
# CATSDWAN_INSTANCES=              # more Managers: CATSDWAN_<NAME>_URL, _USERNAME, _PASSWORD, _TENANT ...

# MCP server
# MCP_TRANSPORT=stdio         # or http
# MCP_AUTH_TOKENS=            # name:sha256:<hex>, required for http (cat-sdwan-mcp-server token <name>)
# MCP_ENABLE_WRITES=false
# MCP_ENABLE_DANGEROUS=false
# MCP_CACHE_DIR=
# LOG_LEVEL=INFO
