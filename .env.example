# Copy to .env (git-ignored, chmod 600) and fill in. Variable names only; never commit values.
SDWAN_URL=https://sdwan-manager.example.com
SDWAN_USERNAME=
SDWAN_PASSWORD=
SDWAN_VERIFY_SSL=true
# SDWAN_CA_BUNDLE=/path/to/ca.pem
# SDWAN_TIMEOUT=30
# SDWAN_RETRIES=2
# SDWAN_RATE_LIMIT=             # requests per minute (unset = unlimited)
# SDWAN_MAX_CONCURRENCY=

# MCP server
# MCP_TRANSPORT=stdio         # or http
# MCP_AUTH_TOKENS=            # name:sha256:<hex>, required for http (cat-sdwan-mcp-server token <name>)
# MCP_ENABLE_WRITES=false
# MCP_ENABLE_DANGEROUS=false
# MCP_CACHE_DIR=
# LOG_LEVEL=INFO
