# Copy to .env (git-ignored, chmod 600) and fill in. Variable names only; never commit values.
CATSDWAN_URL=https://sdwan-manager.example.com
CATSDWAN_USERNAME=
CATSDWAN_PASSWORD=
CATSDWAN_VERIFY_SSL=true
# CATSDWAN_CA_BUNDLE=/path/to/ca.pem
# CATSDWAN_TIMEOUT=30
# CATSDWAN_RETRIES=2
# CATSDWAN_RATE_LIMIT=             # requests per minute (unset = unlimited)
# CATSDWAN_MAX_CONCURRENCY=

# MCP server
# MCP_TRANSPORT=stdio         # or http
# MCP_AUTH_TOKENS=            # name:sha256:<hex>, required for http (cat-sdwan-mcp-server token <name>)
# MCP_ENABLE_WRITES=false
# MCP_ENABLE_DANGEROUS=false
# MCP_CACHE_DIR=
# LOG_LEVEL=INFO
