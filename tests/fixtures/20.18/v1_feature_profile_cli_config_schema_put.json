                "encryptionSupportedField": "<password_text>"
              },
              {
                "cliSyntax": "key <redacted> <key_chain_name>\n key-string <redacted> <keystring_text>",
                "encryptionSupportedField": "<keystring_text>"
              },
              {
                "cliSyntax": "ntp authentication-key <redacted> md5 <authkey_text>",
                "encryptionSupportedField": "<authkey_text>"
              },
              {
                "cliSyntax": "controller Cellular myCellular\n profile id <profile_id> apn <apn_name> authentication <chap/pap/pap_chap> username <user_name> password <redacted>",
                "encryptionSupportedField": "<password_text>"
              },
              {
                "cliSyntax": "interface Loopback<no>\n ip ospf message-digest-key <redacted> md5 <md5key_text>",
                "encryptionSupportedField": "<md5key_text>"
              },
              {
                "cliSyntax": "interface GigabitEthernet<no>\n ip ospf message-digest-key <redacted> md5 <md5key_text>",
                "encryptionSupportedField": "<md5key_text>"
              },
              {
                "cliSyntax": "interface TenGigabitEthernet<no>\n ip ospf message-digest-key <redacted> md5 <md5key_text>",
                "encryptionSupportedField": "<md5key_text>"
              },
              {
                "cliSyntax": "interface HundredGigE<no>\n ip ospf message-digest-key <redacted> md5 <md5key_text>",
                "encryptionSupportedField": "<md5key_text>"
              },
              {
                "cliSyntax": "interface FortyGigabitEthernet<no>\n ip ospf message-digest-key <redacted> md5 <md5key_text>",
                "encryptionSupportedField": "<md5key_text>"
              },
              {
                "cliSyntax": "interface Vlan<no>\n ip ospf message-digest-key <redacted> md5 <md5key_text>",
                "encryptionSupportedField": "<md5key_text>"
              },
              {
                "cliSyntax": "ip msdp vrf <vrf_name> password <redacted> <peer_name> <password_text>",
                "encryptionSupportedField": "<password_text>"
              }
            ]
          }
        },
        "examples": [
          {
            "data": {
              "config": "bfd default-dscp 48\nbfd app-route multiplier 6\nbfd app-route poll-interval 600000"
            },
            "name": "CliConfigFeature"
          },
          {
            "data": {
              "config": "vrf definition 100"
            },
            "name": "CliConfigFeature"
          }
        ]
      }
