              {
                "cliSyntax": "aaa group server radius <server_group>\n server-private <ip/host_name> key <redacted> <key_text>",
                "encryptionSupportedField": "<key_text>"
              },
              {
                "cliSyntax": "aaa group server tacacs+ <server_group>\n server-private <ip/host_name> key <redacted> <key_text>",
                "encryptionSupportedField": "<key_text>"
              },
              {
                "cliSyntax": "radius-server key <redacted> <key_text>",
                "encryptionSupportedField": "<key_text>"
              },
              {
                "cliSyntax": "tacacs-server key <redacted> <key_text>",
                "encryptionSupportedField": "<key_text>"
              },
              {
                "cliSyntax": "aaa server radius dynamic-author\n server-key <redacted> <key_text>",
                "encryptionSupportedField": "<key_text>"
              },
              {
                "cliSyntax": "aaa server radius dynamic-author\n client <ipv4/ipv6> vrf <vrf_name> server-key <redacted> <key_text>",
                "encryptionSupportedField": "<key_text>"
              },
              {
                "cliSyntax": "snmp-server host <ip/snmp_notification_host> <community_or_user>",
                "encryptionSupportedField": "<community_or_user>"
              },
              {
                "cliSyntax": "snmp-server community <snmp_community>",
                "encryptionSupportedField": "<snmp_community>"
              },
              {
                "cliSyntax": "snmp-server host <host_ip> <community-name>",
                "encryptionSupportedField": "<community_name>"
              },
              {
                "cliSyntax": "snmp-server host <host_ip> <community_name> udp-port <port_number>",
                "encryptionSupportedField": "<community_name>"
              },
              {
                "cliSyntax": "snmp-server host <host_ip> vrf <vrf_name> <community_name>",
