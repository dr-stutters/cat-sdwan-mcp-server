{
  "request": {
    "$schema": "http://json-schema.org/draft/2019-09/schema",
    "$id": "https://cisco.com/schema/profileparcel/sdwan/cli/config/put/request_schema.json",
    "title": "Config Parcel Schema",
    "description": "Config profile parcel schema for PUT request",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "pattern": "^[^&<>! \"]+$",
        "minLength": 1,
        "maxLength": 128
      },
      "description": {
        "type": "string"
      },
      "data": {
        "type": "object",
        "properties": {
          "config": {
            "type": "string"
          }
        },
        "required": [
          "config"
        ],
        "additionalProperties": false
      },
      "metadata": {
        "supportedDeviceTypes": [
          "all"
        ],
        "minVManageVersion": "20.15.1"
      },
      "documentation": {
        "description": "This is the documentation for PUT request schema for Config profile parcel",
        "details-1": "data.config attribute will have device CLI configuration as string",
        "properties": {
